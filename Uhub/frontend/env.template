# Uhub Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables for the Uhub application

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# Application Configuration
REACT_APP_APP_NAME=Uhub
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ADMIN_EMAIL=admin@yourcompany.com
REACT_APP_SUPPORT_EMAIL=support@yourcompany.com

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG_MODE=false

# SECURITY: Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control
# NEVER share your API keys
# Use different keys for development and production 